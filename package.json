{
  "name": "rhea",
  "private": true,
  "type": "module",
  "scripts": {
    "rag": "node --env-file=.env premier-rag.ts",
    "verifier": "node --env-file=.env src/outils/verifier-config.ts",
    "typecheck": "tsc -p .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U rhea -d rhea",
    "essai:pgvector": "node --env-file=.env src/outils/essai-pgvector.ts",
    "essai:ollama": "node --env-file=.env src/outils/essai-ollama.ts",
    "corpus": "node src/outils/inventaire-corpus.ts",
    "carte": "node --env-file=.env src/outils/carte-des-sens.ts",
    "similarite": "node --env-file=.env src/outils/essai-similarite.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
