{
  "name": "rhea",
  "private": true,
  "type": "module",
  "scripts": {
    "rag": "node --env-file=.env premier-rag.ts",
    "verifier": "node --env-file=.env src/outils/verifier-config.ts",
    "typecheck": "tsc -p .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U rhea -d rhea",
    "essai:pgvector": "node --env-file=.env src/outils/essai-pgvector.ts",
    "essai:ollama": "node --env-file=.env src/outils/essai-ollama.ts",
    "corpus": "node src/outils/inventaire-corpus.ts",
    "carte": "node --env-file=.env src/outils/carte-des-sens.ts",
    "similarite": "node --env-file=.env src/outils/essai-similarite.ts",
    "test": "node --test",
    "essai:embeddings": "node --env-file=.env src/outils/essai-embeddings.ts",
    "multilingue": "node --env-file=.env src/outils/essai-multilingue.ts",
    "chercher": "node --env-file=.env src/outils/chercher.ts",
    "extraire": "node src/outils/extraire.ts",
    "pdf:brut": "node src/outils/pdf-brut.ts",
    "tickets": "node src/outils/tickets.ts",
    "documents": "node src/outils/documents.ts",
    "metadonnees": "node src/outils/metadonnees.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "cheerio": "^1.2.0",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
