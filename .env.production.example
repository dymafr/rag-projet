# La configuration de production de Rhéa (chapitre 14, leçon 10). Copiez ce fichier en .env.production : il ne contient
# AUCUNE clé. Les clés et le mot de passe de la base vont dans secrets/, un fichier par secret (jamais versionnés) :
#   secrets/mot_de_passe_base, secrets/anthropic_api_key, secrets/openai_api_key, secrets/voyage_api_key
# (un fournisseur que vous n'utilisez pas : laissez son fichier vide). Les valeurs ci-dessous sont celles choisies sur le
# jeu d'évaluation aux leçons 3 à 5 : remplacez-les par les vôtres, et refaites la barrière de qualité (leçon 5) après
# tout changement de modèle

# Génération, et le repli si le fournisseur principal ne répond plus (leçon 8). L'agent au palier au-dessus du plus
# petit (leçon 5 : le plus petit plafonnait sur les questions nouvelles du jeu caché) ; les étapes de la recherche
# (reclassement, filtres extraits, condensation) restent sur le plus petit, qui y suffit et lit l'essentiel des tokens.
# Le LLM de la recherche écrit aussi le contexte des chunks qui n'en ont pas encore (donnees/contextes.json)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_RECHERCHE_PROVIDER=openai
LLM_RECHERCHE_MODEL=gpt-6-luna
LLM_REPLI_PROVIDER=openai
LLM_REPLI_MODEL=gpt-6.1-sol

# Embeddings : ceux avec lesquels l'index et le plancher d'abstention ont été construits (leçon 3)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Chaque morceau reçoit, avant d'être indexé, une phrase qui le situe dans son document (npm run decouper)
CONTEXTUALISER=oui
# Le reclassement des candidats par le LLM (Voyage aussi convient : RERANK_PROVIDER=voyage, RERANK_MODEL=rerank-3)
RECLASSEMENT=oui
RERANK_PROVIDER=llm
# La vérification de la réponse par un second appel (leçon 4) : mesurée, elle retirait plus de réponses justes que fausses
VERIFICATION=non

# Production : pas d'inspection (ni trace dans le navigateur, ni routes /api)
INSPECTION=non
# Le cache sémantique, avec le seuil mesuré par npm run cache:mesurer pour ce modèle d'embedding (leçon 6)
CACHE_SEMANTIQUE=oui
CACHE_SEUIL=0.88
# Au plus tant de questions traitées à la fois, et en attente derrière (leçon 8)
QUESTIONS_SIMULTANEES=8
QUESTIONS_EN_ATTENTE=40
