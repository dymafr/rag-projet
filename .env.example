# Copiez ce fichier en .env, puis renseignez au moins la clé du fournisseur de génération.
# Le fichier .env ne doit jamais être versionné ni affiché à l'écran.

# Génération : anthropic, openai ou ollama (local, sans clé)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5

# Embeddings : transformers (local, sans clé), ollama (local, sans clé), openai ou voyage
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/multilingual-e5-base
# Vecteurs plus courts, si le modèle le permet (openai, voyage, certains modèles Ollama) :
# EMBEDDING_DIMENSIONS=256

# Ollama : adresse du serveur local. Pour tout faire en local, remplacez les lignes ci-dessus par :
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:4b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# Base PostgreSQL lancée par docker compose (identifiants de développement local)
DATABASE_URL=postgres://rhea:rhea@localhost:5432/rhea

# Clés d'API : seules celles des fournisseurs choisis sont requises
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
