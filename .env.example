# Copiez ce fichier en .env, puis renseignez au moins la clé du fournisseur de génération.
# Le fichier .env ne doit jamais être versionné ni affiché à l'écran.

# Génération : anthropic, openai ou ollama (local, sans clé)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5

# Embeddings : transformers (local, sans clé), ollama (local, sans clé), openai ou voyage
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/bge-m3
# Vecteurs plus courts, si le modèle le permet (openai, voyage, certains modèles Ollama) :
# EMBEDDING_DIMENSIONS=256
# Reclassement (chapitre 9) : le cross-encoder local, chargé par Transformers.js au premier reclassement
RERANK_MODEL=onnx-community/bge-reranker-v2-m3-ONNX

# Ollama : adresse du serveur local. Pour tout faire en local, remplacez les lignes ci-dessus par :
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:e4b
# (gemma3:4b, le modèle du chapitre 2, est plus léger, mais refuse moins bien les questions hors sujet)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# (avec un autre modèle d'embedding, relancez npm run seuils : le seuil d'abstention dépend du modèle)
# Évaluation (chapitre 8) : le modèle du juge ; par défaut, LLM_MODEL. Son fournisseur : JUGE_PROVIDER (chapitre 14)
# JUGE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# RAG géré (chapitre 11) : le modèle OpenAI qui répond avec l'outil file_search ; demande OPENAI_API_KEY
# FILE_SEARCH_MODEL=gpt-6-luna
# Lecture des documents scannés (chapitre 12) : un modèle de vision servi par Ollama ; par défaut, LLM_MODEL si LLM_PROVIDER=ollama
# VISION_MODEL=gemma4:e4b
# Mastra (chapitre 11) : pas de télémétrie envoyée par ses outils en ligne de commande
MASTRA_TELEMETRY_DISABLED=1

# Chapitre 14 : la production. L'interface d'inspection montre chaque étape dans le navigateur ; non en production
# INSPECTION=oui
# Leçon 3 : le juge chez un autre fournisseur que LLM_PROVIDER (par défaut, le même ; sinon, JUGE_MODEL est requis) ;
# le reclassement des passages, et son reclasseur : le cross-encoder local (transformers), celui de Voyage (avec
# VOYAGE_API_KEY) ou le LLM (llm). L'API de Voyage répond sur ai.mongodb.com, ou sur eu.ai.mongodb.com pour garder les
# textes en Europe (la clé doit avoir été créée pour cette géographie)
# JUGE_PROVIDER=openai
# Contextualiser chaque chunk au découpage (un appel au LLM par chunk nouveau ou modifié, puis npm run indexer)
# CONTEXTUALISER=oui
# RECLASSEMENT=oui
# RERANK_PROVIDER=llm
# RERANK_PROVIDER=voyage
# RERANK_MODEL=rerank-3
# VOYAGE_BASE_URL=https://eu.ai.mongodb.com/v1

# Base PostgreSQL lancée par docker compose (identifiants de développement local)
DATABASE_URL=postgres://rhea:rhea@localhost:5432/rhea

# Clés d'API : seules celles des fournisseurs choisis sont requises
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
